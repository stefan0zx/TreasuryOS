# LLM_API_KEY: Server-side API key for autonomous treasury allocation agent.
# Supports Google Gemini (AIza...) or NVIDIA NIM / GLM-5-3 (nvapi-...).
LLM_API_KEY="MY_LLM_API_KEY"

# GEMINI_API_KEY: Alternative environment variable for Gemini.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"


